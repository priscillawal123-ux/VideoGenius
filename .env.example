# Video Genius - Arquivo de Configuração de Ambiente
# Copie este arquivo para .env.local e configure suas credenciais

# ===========================================
# CONFIGURAÇÕES OBRIGATÓRIAS DO PROJETO GCP
# ===========================================

# ID do Projeto GCP (NÃO ALTERE - valor correto definido)
GCP_PROJECT=video-genius-prod-v1

# Região GCP (recomendado: us-central1)
GCP_REGION=us-central1

# Service Account (será configurado automaticamente)
# GCP_SERVICE_ACCOUNT_EMAIL=video-genius-sa@video-genius-prod-v1.iam.gserviceaccount.com

# ===========================================
# CREDENCIAIS GCP
# ===========================================

# Caminho para o arquivo de credenciais do Google Cloud
# Baixe o JSON da Service Account e coloque o caminho aqui
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# ===========================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ===========================================

# Ambiente (development/production)
ENVIRONMENT=development

# Porta do servidor FastAPI
PORT=8080

# URL do worker de renderização (para Cloud Tasks)
RENDER_WORKER_URL=https://video-genius-video-worker-abc123.a.run.app

# ===========================================
# CONFIGURAÇÕES DE BANCO DE DADOS
# ===========================================

# BigQuery Dataset
BIGQUERY_DATASET=video_genius_dataset

# ===========================================
# CONFIGURAÇÕES DE STORAGE
# ===========================================

# Bucket do Cloud Storage
CLOUD_STORAGE_BUCKET=video-genius-prod-v1-storage

# ===========================================
# CONFIGURAÇÕES DE MONITORAMENTO
# ===========================================

# Cloud Logging habilitado
ENABLE_CLOUD_LOGGING=true

# Métricas do Prometheus habilitadas
ENABLE_PROMETHEUS_METRICS=true

# ===========================================
# CONFIGURAÇÕES DE SEGURANÇA
# ===========================================

# JWT Secret (gere um novo para produção)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# Tempo de expiração do token JWT (em minutos)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ===========================================

# Debug mode
DEBUG=true

# Reload automático
RELOAD=true

# ===========================================
# INSTRUÇÕES DE CONFIGURAÇÃO
# ===========================================
#
# 1. Copie este arquivo: cp .env.example .env.local
# 2. Configure GOOGLE_APPLICATION_CREDENTIALS com o caminho correto
# 3. Para produção, defina ENVIRONMENT=production
# 4. Para produção, gere uma nova JWT_SECRET_KEY segura
# 5. Configure RENDER_WORKER_URL com a URL real do worker
#
# IMPORTANTE: Nunca commite o arquivo .env.local no Git!