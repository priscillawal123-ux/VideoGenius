[
  {
    "key": "ctrl+shift+g",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "gh copilot suggest -t shell\u000D"
    },
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+h",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "gh status\u000D"
    }
  },
  {
    "key": "ctrl+shift+p ctrl+r",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "gh pr create --fill --web\u000D"
    }
  },
  {
    "key": "ctrl+shift+i",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "gh issue list --assignee @me\u000D"
    }
  },
  {
    "key": "ctrl+shift+b",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "gh browse\u000D"
    }
  },
  {
    "key": "ctrl+shift+c ctrl+i",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "gh pr checks\u000D"
    }
  },
  {
    "key": "ctrl+shift+t",
    "command": "workbench.action.tasks.runTask",
    "args": "Test: Run All"
  },
  {
    "key": "ctrl+shift+l",
    "command": "workbench.action.tasks.runTask",
    "args": "Lint: Check All"
  },
  {
    "key": "ctrl+shift+f ctrl+m",
    "command": "workbench.action.tasks.runTask",
    "args": "Format: Fix All"
  },
  {
    "key": "f5",
    "command": "workbench.action.debug.start",
    "when": "!inDebugMode"
  },
  {
    "key": "ctrl+f5",
    "command": "workbench.action.tasks.runTask",
    "args": "Docker: Run Local"
  },
  {
    "key": "ctrl+shift+d ctrl+b",
    "command": "workbench.action.tasks.runTask",
    "args": "Docker: Build Development"
  }
]