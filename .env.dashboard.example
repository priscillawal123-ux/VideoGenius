# ============================================================================
# Dashboard Configuration
# ============================================================================

# FRONTEND CONFIGURATION

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Features
VITE_ENABLE_GITHUB_SYNC=true
VITE_ENABLE_REALTIME=true

# ============================================================================
# BACKEND CONFIGURATION

# GitHub Integration
GITHUB_TOKEN=your-github-token
GITHUB_OWNER=priscillawal123-ux
GITHUB_REPO=VideoGenius

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Google Cloud
GCP_PROJECT_ID=video-genius-prod-v1

# ============================================================================
# DASHBOARD SETTINGS

# Task Phases
PHASE_1_NAME=MVP
PHASE_1_START=2024-10-18
PHASE_1_END=2024-11-15

PHASE_2_NAME=AI Integration
PHASE_2_START=2024-11-16
PHASE_2_END=2024-12-20

PHASE_3_NAME=Production
PHASE_3_START=2024-12-21
PHASE_3_END=2025-01-31

PHASE_4_NAME=Analytics
PHASE_4_START=2025-02-01
PHASE_4_END=2025-02-15

# Sync Settings
GITHUB_SYNC_INTERVAL=3600  # seconds (1 hour)
REALTIME_ENABLED=true
CACHE_TTL=300  # seconds (5 minutes)

# ============================================================================
# LOGGING

LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# DEVELOPMENT

DEBUG=false
ENVIRONMENT=production
