{
  "folders": [
    {
      "path": ".",
      "name": "AI Assistant Alfred"
    }
  ],
  "settings": {
    "github.copilot.enable": {
      "*": true,
      "yaml": true,
      "plaintext": false,
      "markdown": true,
      "python": true,
      "dockerfile": true,
      "shellscript": true,
      "json": true,
      "jupyter": true
    },
    "github.copilot.editor.enableAutoCompletions": true,
    "github.copilot.chat.welcomeMessage": "first",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvInCurrentTerminal": true,
    "python.languageServer": "Pylance",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.extraPaths": [
      "${workspaceFolder}/Alfred/Alfred"
    ],
    "python.formatting.blackPath": "${workspaceFolder}/.venv/bin/black",
    "python.linting.ruffPath": "${workspaceFolder}/.venv/bin/ruff",
    "python.linting.mypyPath": "${workspaceFolder}/.venv/bin/mypy",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "jupyter.notebookFileRoot": "${workspaceFolder}",
    "jupyter.runStartupCommands": [
      "%load_ext autoreload",
      "%autoreload 2",
      "import sys; sys.path.append('${workspaceFolder}/Alfred/Alfred')"
    ],
    "python.analysis.diagnosticSeverityOverrides": {
      "reportMissingImports": "none",
      "reportMissingTypeStubs": "none"
    },
    "python.analysis.includeFileSpecs": [
      "**/*.py"
    ],
    "python.analysis.exclude": [
      "**/node_modules",
      "**/__pycache__",
      "**/.venv",
      "**/.mypy_cache",
      "**/.pytest_cache"
    ],
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    },
    "editor.rulers": [
      88,
      120
    ],
    "editor.bracketPairColorization.enabled": true,
    "editor.inlineSuggest.enabled": true,
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "on",
      "strings": "on"
    },
    "editor.suggestSelection": "first",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.mypy_cache": true,
      "**/.ruff_cache": true,
      "**/*.pyc": true,
      "**/.DS_Store": true,
      "**/node_modules": true,
      "**/.venv": true,
      "**/logs/*.log": false,
      "**/data/": false
    },
    "files.watcherExclude": {
      "**/.venv/**": true,
      "**/node_modules/**": true,
      "**/__pycache__/**": true,
      "**/.git/**": true
    },
    "files.associations": {
      "*.env.*": "dotenv",
      "Dockerfile.*": "dockerfile",
      "*.sh": "shellscript",
      "requirements*.txt": "pip-requirements",
      "pyproject.toml": "toml"
    },
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.commandsToSkipShell": [
      "workbench.action.terminal.sendSequence"
    ],
    "terminal.integrated.env.linux": {
      "PYTHONPATH": "${workspaceFolder}/Alfred/Alfred:${workspaceFolder}",
      "OLLAMA_HOST": "http://localhost:11434"
    },
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.postCommitCommand": "none",
    "git.ignoreRebaseWarning": true,
    "docker.dockerPath": "docker",
    "docker.languageserver.diagnostics.deprecatedMaintainer": "warning",
    "errorLens.enabled": true,
    "errorLens.enabledDiagnosticLevels": [
      "error",
      "warning"
    ],
    "todo-tree.general.tags": [
      "BUG",
      "HACK",
      "FIXME",
      "TODO",
      "XXX",
      "[ ]",
      "[x]",
      "NOTE",
      "REVIEW"
    ],
    "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\d+.))\\s*($TAGS)",
    "autoDocstring.docstringFormat": "google",
    "autoDocstring.startOnNewLine": false,
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
      }
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[yaml]": {
      "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[shellscript]": {
      "editor.defaultFormatter": "timonwong.shellcheck"
    },
    "jupyter.interactiveWindow.creationMode": "perFile",
    "containers.containerCommand": "docker"
  },
  "extensions": {
    "recommendations": [
      "github.copilot",
      "github.copilot-chat",
      "github.vscode-pull-request-github",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.black-formatter",
      "charliermarsh.ruff",
      "njpwerner.autodocstring",
      "ms-python.debugpy",
      "ms-toolsai.jupyter",
      "ms-toolsai.vscode-jupyter-powertoys",
      "ms-windows-ai-studio.windows-ai-studio",
      "github.copilot-labs",
      "googlecloudtools.cloudcode",
      "ms-azuretools.vscode-docker",
      "ms-kubernetes-tools.vscode-kubernetes-tools",
      "redhat.vscode-yaml",
      "eamodio.gitlens",
      "mhutchie.git-graph",
      "donjayamanne.githistory",
      "usernamehw.errorlens",
      "gruntfuggly.todo-tree",
      "christian-kohler.path-intellisense",
      "wayou.vscode-todo-highlight",
      "oderwat.indent-rainbow",
      "ms-vscode.vscode-json",
      "pkief.material-icon-theme",
      "aaron-bond.better-comments",
      "streetsidesoftware.code-spell-checker",
      "mechatroner.rainbow-csv",
      "foxgis.vscode-shell-format",
      "jeff-hykin.better-shellscript-syntax",
      "rangav.vscode-thunder-client"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Python: FastAPI Alfred",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "args": [
          "Alfred.main:app",
          "--reload",
          "--host",
          "0.0.0.0",
          "--port",
          "8000"
        ],
        "jinja": true,
        "justMyCode": false,
        "env": {
          "PYTHONPATH": "${workspaceFolder}/Alfred/Alfred:${workspaceFolder}",
          "ENV": "development"
        },
        "cwd": "${workspaceFolder}/Alfred/Alfred"
      },
      {
        "name": "Python: Train DeepSeek Model",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/Alfred/Alfred/train_deepseek.py",
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": {
          "PYTHONPATH": "${workspaceFolder}/Alfred/Alfred:${workspaceFolder}",
          "CUDA_VISIBLE_DEVICES": "0"
        }
      },
      {
        "name": "Python: Current File",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": {
          "PYTHONPATH": "${workspaceFolder}/Alfred/Alfred:${workspaceFolder}"
        }
      },
      {
        "name": "Python: Pytest Current File",
        "type": "debugpy",
        "request": "launch",
        "module": "pytest",
        "args": [
          "${file}",
          "-v",
          "-s"
        ],
        "console": "integratedTerminal",
        "justMyCode": false
      },
      {
        "name": "Python: Run Alfred Dashboard",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/Alfred/run_dashboard.py",
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": {
          "PYTHONPATH": "${workspaceFolder}/Alfred/Alfred:${workspaceFolder}"
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Setup: Complete Environment",
        "type": "shell",
        "command": "${workspaceFolder}/setup.sh",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        },
        "problemMatcher": []
      },
      {
        "label": "Alfred: Start All Services",
        "type": "shell",
        "command": "${workspaceFolder}/manage.sh start",
        "group": "build",
        "presentation": {
          "reveal": "always"
        },
        "problemMatcher": []
      },
      {
        "label": "Alfred: Stop All Services",
        "type": "shell",
        "command": "${workspaceFolder}/manage.sh stop",
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "Alfred: Status",
        "type": "shell",
        "command": "${workspaceFolder}/manage.sh status",
        "group": "test",
        "presentation": {
          "reveal": "always"
        },
        "problemMatcher": []
      },
      {
        "label": "Alfred: Diagnose",
        "type": "shell",
        "command": "${workspaceFolder}/manage.sh diagnose",
        "group": "test",
        "presentation": {
          "reveal": "always"
        },
        "problemMatcher": []
      },
      {
        "label": "Train: DeepSeek Model",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/bin/python ${workspaceFolder}/Alfred/Alfred/train_deepseek.py",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        },
        "problemMatcher": []
      },
      {
        "label": "GH: Authenticate",
        "type": "shell",
        "command": "gh auth login && gh auth refresh -s copilot",
        "group": "none",
        "problemMatcher": []
      },
      {
        "label": "GH: Create PR (Quick)",
        "type": "shell",
        "command": "gh pr create --fill --web",
        "group": "none",
        "problemMatcher": []
      },
      {
        "label": "GH: View PR Status",
        "type": "shell",
        "command": "gh pr status && gh pr checks",
        "group": "none",
        "presentation": {
          "reveal": "always"
        },
        "problemMatcher": []
      },
      {
        "label": "Test: Run All",
        "type": "shell",
        "command": "cd ${workspaceFolder} && python -m pytest Alfred/Alfred/tests/ -v",
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "problemMatcher": []
      },
      {
        "label": "Lint: Check All",
        "type": "shell",
        "command": "cd ${workspaceFolder} && ruff check Alfred/Alfred/ && mypy Alfred/Alfred/",
        "group": "test"
      },
      {
        "label": "Format: Fix All",
        "type": "shell",
        "command": "cd ${workspaceFolder} && black Alfred/Alfred/ && ruff check --fix Alfred/Alfred/",
        "group": "none",
        "problemMatcher": []
      },
      {
        "label": "Pre-commit: Run All Hooks",
        "type": "shell",
        "command": "cd ${workspaceFolder} && pre-commit run --all-files",
        "group": "test",
        "problemMatcher": []
      }
    ]
  }
}